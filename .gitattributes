* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf

# Runtime and deployment text must remain Linux-compatible.
*.py text eol=lf
*.sh text eol=lf
*.service text eol=lf
*.socket text eol=lf
*.timer text eol=lf
*.conf text eol=lf
*.nft text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Packaged and media artifacts are binary.
*.whl binary
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
