# Local environments and interpreter caches
.venv/
venv/
__pycache__/
*.py[cod]
*.pyd

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python build outputs
build/
dist/
*.egg-info/
*.whl

# Existing generated 0.2.x release snapshots (preserved in the full backup)
0.2.0/
release/
release-final/
release-0.2.1/

# Local runtime state and secrets
*.db
*.db-shm
*.db-wal
*.log
.env
*.env
credentials.env

# Editor, OS and linked-worktree files
.DS_Store
Thumbs.db
.idea/
.vscode/
.worktrees/

# v3 release artifacts are intentionally versioned, including offline wheels.
!release-v3-br0-final/
!release-v3-br0-final/**
!release-v3-br0-final/wheelhouse/
!release-v3-br0-final/wheelhouse/**
!release-v3-br0-final/SHA256SUMS

# v0.4.0 release documentation is versioned (docs/release).
!docs/release/
!docs/release/**
