{
  "name": "capability-files",
  "plugin_type": "capability",
  "version": "0.4.2",
  "api_min": "1.0",
  "api_max": "1.0",
  "executable": "a4diag_builtin_plugins.capability_files:main",
  "socket": "/run/a4diag/capability-files.sock",
  "config_schema": "schemas/capability-files.json",
  "operations": [
    {
      "name": "files.replace_managed_file",
      "risk_floor": "low",
      "reversible": true,
      "supports_prepare": true,
      "supports_verify": true,
      "supports_reconcile": true,
      "supports_undo": true,
      "parameters_schema": {
        "type": "object",
        "properties": {
          "content": {"type": "string"},
          "mode": {"type": "integer"}
        },
        "required": ["content"],
        "additionalProperties": false
      }
    },
    {
      "name": "files.set_mode",
      "risk_floor": "low",
      "reversible": true,
      "supports_prepare": true,
      "supports_verify": true,
      "supports_reconcile": true,
      "supports_undo": true,
      "parameters_schema": {
        "type": "object",
        "properties": {
          "mode": {"type": "integer"}
        },
        "required": ["mode"],
        "additionalProperties": false
      }
    }
  ],
  "permissions": [
    "read:managed-file",
    "write:managed-file",
    "exec:a4diag-transport-helper"
  ],
  "network_access": ["none"],
  "secret_refs": [],
  "target_compatibility": [
    "linux:systemd",
    "rocky:8",
    "rocky:9",
    "almalinux:8",
    "almalinux:9",
    "rhel:8",
    "rhel:9",
    "ubuntu:22.04",
    "ubuntu:24.04",
    "debian:12"
  ],
  "read_risk_floor": "low",
  "write_risk_floor": "high"
}
