{
  "name": "capability-kubernetes",
  "plugin_type": "capability",
  "version": "1.0.0",
  "api_min": "1.0",
  "api_max": "1.0",
  "executable": "a4diag_builtin_plugins.capability_kubernetes:main",
  "socket": "/run/a4diag/capability-kubernetes.sock",
  "config_schema": "schemas/capability-kubernetes.json",
  "operations": [
    {
      "name": "kubernetes.restore-image",
      "effect_kind": "compensatable",
      "risk_floor": "high",
      "reversible": false,
      "supports_prepare": true,
      "supports_verify": true,
      "supports_reconcile": true,
      "supports_undo": true,
      "parameters_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "name": "kubernetes.restart",
      "effect_kind": "compensatable",
      "risk_floor": "high",
      "reversible": false,
      "supports_prepare": true,
      "supports_verify": true,
      "supports_reconcile": true,
      "supports_undo": false,
      "parameters_schema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    }
  ],
  "permissions": [
    "exec:a4diag-transport-helper"
  ],
  "network_access": [
    "none"
  ],
  "secret_refs": [],
  "target_compatibility": [
    "ubuntu:22.04",
    "ubuntu:24.04",
    "debian:12"
  ],
  "read_risk_floor": "low",
  "write_risk_floor": "high"
}
